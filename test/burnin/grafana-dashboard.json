{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Node burn-in: memory, goroutines, peers, workload errors, and signed-discovery freshness.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Go heap in use and total resident process memory. Compare both over the full workload and recovery window.",
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "go_memstats_heap_inuse_bytes{cluster=\"burnin\"}",
          "legendFormat": "{{instance}} heap",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "process_resident_memory_bytes{cluster=\"burnin\"}",
          "legendFormat": "{{instance}} RSS",
          "refId": "B"
        }
      ],
      "title": "Memory per node",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Goroutines per node; investigate sustained growth after workload or reconnect activity settles.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "go_goroutines{cluster=\"burnin\"}",
          "legendFormat": "{{instance}} goroutines",
          "refId": "A"
        }
      ],
      "title": "Goroutines per node",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Active peers per node. Should be 2 on each node (counts other peers, not self). Drops indicate ping failures or evictions.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "gossip_peers_active{cluster=\"burnin\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(gossip_peer_evictions_total{cluster=\"burnin\"}[5m]) * 60",
          "legendFormat": "{{instance}} evictions/min",
          "refId": "B"
        }
      ],
      "title": "Peer list size (and eviction rate)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Workload generator status mix per second over 5m windows. PUT requests use unique URLs per iteration (`bench-agent-X-{iter}`), creating ~5900+ time series \u2014 querying across all of them takes 26+ seconds and times out Grafana panels. Queries here are restricted to the bounded-cardinality ops (get_existing, head, list, get_expired) plus the explicit soft_failures_202 counter. PUT successes are implicit in the absence of soft/hard failures. The 'graveyard 404 (probe)' line is intentional \u2014 workload.js doGetExpired hits known-expired keys at 15% of iterations to verify the expired-key path. Real hard failures (5xx) and PUT 202 timeouts should both stay near zero.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(k6_http_reqs_total{op=~\"get_existing|head|list\",status=~\"5..\"}[5m]))",
          "legendFormat": "hard failures (5xx)/sec",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(k6_http_reqs_total{op=~\"get_existing|head|list\",status=~\"4..\"}[5m]))",
          "legendFormat": "GET/HEAD/list 4xx (expect rise post-T+24h: ref-set TTL)/sec",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(k6_http_reqs_total{op=\"get_expired\"}[5m]))",
          "legendFormat": "graveyard 404 (probe)/sec",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(k6_soft_failures_202_total[5m]))",
          "legendFormat": "PUT 202 (soft)/sec",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(k6_http_reqs_total{op=~\"get_existing|head|list\",status=\"200\"}[5m]))",
          "legendFormat": "successful (GET/HEAD/list)/sec",
          "refId": "C"
        }
      ],
      "title": "Workload status mix",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Cache-file freshness: seconds since the last successful refresh wrote root-list.json. Sawtooth between 0 and ~25min (one tooth per refresh cycle) means refresh is working. A flat upward line means refresh is failing.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1500
              },
              {
                "color": "red",
                "value": 1700
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - discovery_last_refresh_unix_seconds{cluster=\"burnin\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Cache file age (since last refresh)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "burnin",
    "network"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Network Burn-in",
  "uid": "network-burnin",
  "version": 1,
  "weekStart": ""
}
