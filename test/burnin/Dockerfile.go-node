FROM golang:1.27.1-alpine AS builder
RUN apk add --no-cache git ca-certificates

# TEST_OMEGA_PUBKEY is the base64-encoded Ed25519 pubkey for the burn-in run.
# It is baked into internal/trust/omega.go at build time, replacing the
# unset anchor. Burn-in images MUST NOT be published to a public
# registry — the corresponding private key should never leave the observer.
ARG TEST_OMEGA_PUBKEY
RUN test -n "$TEST_OMEGA_PUBKEY" || (echo "TEST_OMEGA_PUBKEY build-arg is required" >&2 && exit 2)

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# Replace only the unset anchor. Use | because base64 can contain /.
RUN sed -i "s|OmegaPubkey = \"\"|OmegaPubkey = \"${TEST_OMEGA_PUBKEY}\"|" internal/trust/omega.go && \
    grep -q "OmegaPubkey = \"${TEST_OMEGA_PUBKEY}\"" internal/trust/omega.go || \
    (echo "pubkey bake failed — unset anchor not found or replacement mismatched" >&2 && exit 3)

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o server ./cmd/server

FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata
RUN adduser -D -s /bin/sh node
WORKDIR /app
COPY --from=builder /app/server .
RUN chown -R node:node /app && \
    mkdir -p /data/cache && chown node:node /data/cache
USER node
ENV NODE_CACHE_DIR=/data/cache
EXPOSE 8080
CMD ["./server"]
